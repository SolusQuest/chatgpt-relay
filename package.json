{
  "name": "gpt-relay",
  "version": "1.0.0",
  "description": "ChatGPT 网页自动 Relay 工具（SQLite 队列 + MV3 扩展）",
  "main": "server/index.ts",
  "bin": {
    "gpt-relay": "./bin/gpt-relay.ts"
  },
  "type": "module",
  "scripts": {
    "start": "tsx server/index.ts",
    "dev": "tsx watch server/index.ts",
