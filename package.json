{
  "name": "gpt-relay",
  "version": "1.0.1",
  "description": "Local SQLite relay and MV3 extension for agent reviews through ChatGPT web sessions",
  "license": "MIT",
  "keywords": [
    "agent",
    "chatgpt",
    "code-review",
    "relay",
    "sqlite",
    "browser-extension"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SolusQuest/chatgpt-relay.git"
  },
  "homepage": "https://github.com/SolusQuest/chatgpt-relay#readme",
  "bugs": {
    "url": "https://github.com/SolusQuest/chatgpt-relay/issues"
  },
  "main": "server/index.ts",
  "bin": {
    "gpt-relay": "./bin/gpt-relay.mjs"
  },
  "type": "module",
  "files": [
    "bin",
    "client",
    "server",
    "service",
    "docs",
    "shared",
    "scripts",
    "extension",
    "workflows",
    "agent-instructions.md",
    "api.md",
    "task-lifecycle.md",
    "README.md",
    "tsconfig.json"
  ],
  "scripts": {
    "start": "tsx server/index.ts",
    "dev": "tsx watch server/index.ts",
    "cli": "tsx bin/gpt-relay.ts",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check:public": "node scripts/check-public-release.ts",
    "icons:generate": "node scripts/gen-icons.ts"
  },
  "dependencies": {
    "bonjour-service": "1.4.4",
    "express": "^4.18.0",
    "tsx": "^4.7.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.1",
    "happy-dom": "20.14.6",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.7.0"
}
